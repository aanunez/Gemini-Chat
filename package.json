{
  "name": "gemini-chat-browser",
  "displayName": "Gemini Chat Browser",
  "description": "Open Gemini in VS Code's Integrated Browser from the Activity Bar.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gemini.openBrowser",
        "title": "Gemini: Open in Integrated Browser"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "geminiPanel",
          "title": "Gemini",
          "icon": "media/gemini.svg"
        }
      ]
    },
    "views": {
      "geminiPanel": [
        {
          "id": "gemini.browser",
          "name": "Gemini Browser",
          "type": "webview"
        }
      ]
    }
  }
}
